{
  "version": 2,

  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",

  "builds": [
    {
      "src": "backend/app.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/index.html"
    }
  ]
}
